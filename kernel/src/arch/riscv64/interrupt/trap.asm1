.section .text
.global common_stub
.extern base_trap

common_stub:
    addi sp, sp, -32*8    
    
    sd x1, 1*8(sp)   # ra
    sd x2, 2*8(sp)   # sp 
    sd x3, 3*8(sp)   # gp
    sd x4, 4*8(sp)   # tp
    sd x5, 5*8(sp)   # t0
    sd x6, 6*8(sp)   # t1
    sd x7, 7*8(sp)   # t2
    sd x8, 8*8(sp)   # s0/fp
    sd x9, 9*8(sp)   # s1
    sd x10, 10*8(sp) # a0
    sd x11, 11*8(sp) # a1
    sd x12, 12*8(sp) # a2
    sd x13, 13*8(sp) # a3
    sd x14, 14*8(sp) # a4
    sd x15, 15*8(sp) # a5
    sd x16, 16*8(sp) # a6
    sd x17, 17*8(sp) # a7
    sd x18, 18*8(sp) # s2
    sd x19, 19*8(sp) # s3
    sd x20, 20*8(sp) # s4
    sd x21, 21*8(sp) # s5
    sd x22, 22*8(sp) # s6
    sd x23, 23*8(sp) # s7
    sd x24, 24*8(sp) # s8
    sd x25, 25*8(sp) # s9
    sd x26, 26*8(sp) # s10
    sd x27, 27*8(sp) # s11
    sd x28, 28*8(sp) # t3
    sd x29, 29*8(sp) # t4
    sd x30, 30*8(sp) # t5
    sd x31, 31*8(sp) # t6

    csrr t0, mepc
    csrr t1, mcause
    csrr t2, mstatus
    
    mv a0, sp         
    
    call base_trap
    
    csrr t0, mstatus
    andi t1, t0, 0x18   
    beqz t1, .skip_swap
    
.skip_swap:
    ld x1, 1*8(sp)   # ra
    ld x2, 2*8(sp)   # sp 
    ld x3, 3*8(sp)   # gp
    ld x4, 4*8(sp)   # tp
    ld x5, 5*8(sp)   # t0
    ld x6, 6*8(sp)   # t1
    ld x7, 7*8(sp)   # t2
    ld x8, 8*8(sp)   # s0/fp
    ld x9, 9*8(sp)   # s1
    ld x10, 10*8(sp) # a0
    ld x11, 11*8(sp) # a1
    ld x12, 12*8(sp) # a2
    ld x13, 13*8(sp) # a3
    ld x14, 14*8(sp) # a4
    ld x15, 15*8(sp) # a5
    ld x16, 16*8(sp) # a6
    ld x17, 17*8(sp) # a7
    ld x18, 18*8(sp) # s2
    ld x19, 19*8(sp) # s3
    ld x20, 20*8(sp) # s4
    ld x21, 21*8(sp) # s5
    ld x22, 22*8(sp) # s6
    ld x23, 23*8(sp) # s7
    ld x24, 24*8(sp) # s8
    ld x25, 25*8(sp) # s9
    ld x26, 26*8(sp) # s10
    ld x27, 27*8(sp) # s11
    ld x28, 28*8(sp) # t3
    ld x29, 29*8(sp) # t4
    ld x30, 30*8(sp) # t5
    ld x31, 31*8(sp) # t6
    
    addi sp, sp, 32*8  
    
    mret

.macro INTERRUPT_STUB num
interrupt_stub_\num:
    j common_stub
.endm

.macro INTERRUPT_ERR_STUB num
interrupt_stub_\num:
    j common_stub
.endm

.altmacro
.set i, 0
.rept 32
    INTERRUPT_STUB %i
    .set i, i + 1
.endr

.set i, 32
.rept 224
    INTERRUPT_STUB %i
    .set i, i + 1
.endr

.section .data
.global interrupts_stub_table
interrupts_stub_table:
.set i, 0
.rept 256
    .quad interrupt_stub_%i
    .set i, i + 1
.endr